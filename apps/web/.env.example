# Copy to .env.local. For local development, `npx supabase status` (from the repo root) prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_from_supabase_status
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Lets the pipeline tell the app when stories changed (POST /api/revalidate). 16+ random characters;
# the workers need the same value in VERILO_REVALIDATE_SECRET.
REVALIDATE_SECRET=
