# Copy to .env.local. For local development, `npx supabase status` (from the repo root) prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_from_supabase_status
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Lets the pipeline tell the app when stories changed (POST /api/revalidate). 16+ random characters;
# the workers need the same value in VERILO_REVALIDATE_SECRET.
REVALIDATE_SECRET=

# The daily briefing (Phase 5).
# Server-only key that bypasses row-level security: the briefing job reads every reader's choices.
SUPABASE_SECRET_KEY=sb_secret_from_supabase_status
# 16+ random characters; the workers need the same value in VERILO_BRIEFING_SECRET.
BRIEFING_SECRET=
# 16+ random characters, different from the above: signs the "Stop these emails" links, so
# changing it breaks links in emails already sent.
UNSUBSCRIBE_SECRET=
# Any SMTP service (Resend, Postmark...). Locally, Mailpit from `npx supabase start`.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASSWORD=
BRIEFING_FROM=Verilo <briefing@example.com>

# The address for privacy and other requests, shown in the privacy policy. Until it's set, the
# policy says contact details are coming.
NEXT_PUBLIC_CONTACT_EMAIL=
