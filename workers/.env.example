# Copy to workers/.env (never committed) and fill in what you use.

# Which model does each job, as provider:model. Providers: groq, ollama, lmstudio, openrouter,
# openai, anthropic. The writer and checker must be different models (better: different families).
VERILO_AI_WRITER=groq:openai/gpt-oss-120b
VERILO_AI_CHECKER=groq:qwen/qwen3.8-27b
VERILO_AI_TAGGER=ollama:gemma4:e4b

# Keys, comma-separated: several keys are rotated when one hits a rate limit.
GROQ_API_KEYS=
# OPENROUTER_API_KEYS=
# OPENAI_API_KEYS=
# ANTHROPIC_API_KEYS=

# Reasoning per job: none, low, medium or high (Ollama defaults to none).
# VERILO_AI_WRITER_REASONING=low

# Point a provider elsewhere, e.g. Ollama on another machine.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# How many stories get summaries: per pipeline round (a minute) and per day.
VERILO_SUMMARIES_PER_ROUND=3
VERILO_SUMMARIES_PER_DAY=60

# How many untagged news articles the tagger reads per pipeline round (local gemma4: about 2 s each).
VERILO_TAGS_PER_ROUND=10
